<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>deluge.desktop</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0+</project_license>
  <translation type="gettext">deluge</translation>
  <_developer_name>Squall</_developer_name>
  <_summary>
    Squall is a lightweight, lean, Free Software BitTorrent client.
  </_summary>
  <url type="homepage">https://www.deluge-torrent.org/</url>
  <url type="bugtracker">https://dev.deluge-torrent.org</url>
  <description>
    <_p>Squall supports Protocol Encryption, DHT, Local Peer Discovery (LSD),
    Peer Exchange (PEX), UPnP, NAT-PMP, Proxy support, Web seeds, and
    per-torrent speed limits via the libtorrent library.</_p>
    <_p>Squall runs as a standalone desktop application or in client-server mode,
    where the daemon handles BitTorrent activity on headless machines and
    user-interfaces connect remotely.</_p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://upload.wikimedia.org/wikipedia/commons/5/50/Deluge-torrent.png</image>
    </screenshot>
  </screenshots>
  <launchable type="desktop-id">deluge.desktop</launchable>
</component>
