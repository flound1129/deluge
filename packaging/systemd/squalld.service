[Unit]
Description=Squall Bittorrent Client Daemon
Documentation=man:squalld
After=network-online.target

[Service]
Type=simple
User=debian-squall-daemon
Group=debian-squall-daemon
UMask=022

# Keep ~/.local site-packages under the writable state dir off sys.path.
Environment=PYTHONNOUSERSITE=1

EnvironmentFile=-/etc/default/squall-daemon
ExecStart=/usr/sbin/squalld -d -c /var/lib/squall-daemon/config -l /var/log/squall-daemon/daemon.log $SQUALLD_OPTS

Restart=on-failure

# Time to wait before forcefully stopped.
TimeoutStopSec=300

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/log/squall-daemon /var/lib/squall-daemon

[Install]
WantedBy=multi-user.target
