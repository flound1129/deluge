[Unit]
Description=Squall Bittorrent Client Web Interface
Documentation=man:deluge-web
After=deluged.service
Wants=deluged.service

[Service]
Type=simple
User=debian-squall-web
Group=debian-squall-web
UMask=027

EnvironmentFile=-/etc/default/squall-web
ExecStart=/usr/bin/deluge-web -d

Restart=on-failure

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/log/squall-web /var/lib/squall-web

[Install]
WantedBy=multi-user.target
