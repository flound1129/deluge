#!/usr/bin/make -f

SHELL := sh -e

VERSION := $(shell dpkg-parsechangelog | awk '/^Version: / { print $$2 }' | rev | cut -d- -f2- | rev)
PYTHON_TAG := $(shell python3 -c 'import sys; print(f"py{sys.version_info.major}{sys.version_info.minor}")')
RUNTIME_LOCK := requirements-lock/runtime-$(PYTHON_TAG)-linux-x86_64.txt

%:
	dh $@ --with python-virtualenv

override_dh_auto_configure:
	# dh_virtualenv handles the Python build

override_dh_auto_build:
	# dh_virtualenv handles the Python build

override_dh_auto_install:
	# dh_virtualenv handles the Python build

override_dh_virtualenv:
	dh_virtualenv \
		--install-suffix deluge \
		--use-system-packages \
		--requirements $(RUNTIME_LOCK) \
		--extra-pip-arg=--require-hashes \
		--extra-pip-arg=--ignore-installed \
		--extra-pip-arg=--find-links=https://github.com/arvidn/libtorrent/releases/expanded_assets/v2.1.2 \
		--skip-install \
		--package squall-common

# User units are opt-in per user (systemctl --user enable), never global.
override_dh_installsystemduser:
	dh_installsystemduser --no-enable

# The web UI listens on all interfaces with a default password, so the admin
# must enable it. deb-systemd-invoke still restarts it on upgrade if running.
override_dh_installsystemd:
	dh_installsystemd -psquall-web --no-enable
	dh_installsystemd --remaining-packages

execute_before_dh_install:
	# Generate desktop file from template (strip intltool underscore prefixes)
	sed 's/^_//; s/=_/=/' deluge/ui/data/share/applications/deluge.desktop.in \
		> deluge/ui/data/share/applications/squall.desktop

execute_before_dh_virtualenv:
	echo "$(VERSION)" | sed 's/~/./' > RELEASE-VERSION

execute_after_dh_virtualenv:
	# Debian's virtualenv seeds pip as a module without a bin/pip script. Upgrade
	# it from the separately hash-locked wheel before building Squall.
	debian/squall-common/opt/venvs/deluge/bin/python -m pip install \
		--require-hashes --upgrade --force-reinstall --no-deps \
		-r requirements-lock/pip-bootstrap.txt
	# Install Squall from this source tree without re-resolving locked dependencies.
	debian/squall-common/opt/venvs/deluge/bin/python -m pip install \
		--no-build-isolation --no-deps .
	# Unpack plugin eggs
	cd debian/squall-common/opt/venvs/deluge/lib/python*/site-packages/deluge/plugins/; \
	for EGG in *.egg; \
	do \
		mkdir -p $${EGG%-py?.*}.egg; \
		unzip -oq $${EGG} -d $${EGG%-py?.*}.egg; \
		rm -f $${EGG}; \
	done
	# Remove bytecode cache directories
	find debian/squall-common -type d -name '__pycache__' | xargs rm -rf

override_dh_strip:
	dh_strip --exclude=site-packages

override_dh_dwz:
	dh_dwz --exclude=site-packages

override_dh_shlibdeps:
	dh_shlibdeps --exclude=site-packages

override_dh_auto_test:
	# disabled

execute_after_dh_auto_clean:
	rm -f RELEASE-VERSION
	rm -f deluge/ui/data/share/applications/squall.desktop

	# Remove build artifacts
	for ITEM in $$(find . -type d -name "*.egg-info" -or -type f -name "*.egg"); \
	do \
		rm -rf "$${ITEM}"; \
	done

	rm -rf deluge/plugins/*/build
	rm -f deluge/ui/web/js/deluge-all-debug.js
	rm -f deluge/ui/web/js/extjs/ext-extensions-debug.js
	rm -f deluge/ui/web/js/gettext.js

	for file in $$(find . -type f -name "*.in"); \
	do \
		rm -f "$$(dirname "$${file}")"/"$$(basename "$${file}" .in)"; \
	done
